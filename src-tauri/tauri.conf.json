{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "myhomeproject",
  "version": "0.0.1",
  "identifier": "alebarto.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "myhomeproject",
        "width": 800,
        "minWidth": 400,
        "height": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlENjg5NzVCMDcwQTdCQTYKUldTbWV3b0hXNWRvblVCZlRQelloQ1lESGw0OXpqczlWUHZvc0QyaURIa3k1V0FDejVzSXJiNDcK",
      "endpoints": [
        "https://github.com/Alebarto99/myHomeProject.git/releases/latest/download/latest.json"
      ]
    }
  }
}

